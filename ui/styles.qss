/* ============ Auto Pilot Qwen 3.8 27B IQ3_Superfast — dark theme ============ */

QWidget {
    background-color: #1b1d23;
    color: #e6e6eb;
    font-size: 13px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", "PingFang SC", "Hiragino Sans GB", "Segoe UI Symbol", "Apple Color Emoji", "Noto Sans", Arial, sans-serif;
}

QMainWindow {
    background-color: #1b1d23;
}

/* ---------- Sidebar ---------- */
#Sidebar {
    background-color: #14161b;
    border-right: 1px solid #262932;
}

#Brand {
    font-size: 17px;
    font-weight: 700;
    color: #f2f2f6;
    padding: 2px 2px 6px 2px;
}

#MutedText {
    color: #8a8f9c;
    font-size: 12px;
}

#ChatList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

#ChatList::item {
    color: #d6d8df;
    padding: 8px 10px;
    border-radius: 8px;
    margin-bottom: 2px;
}

#ChatList::item:hover {
    background-color: #23262f;
}

#ChatList::item:selected {
    background-color: #2c3140;
    color: #ffffff;
}

/* ---------- Buttons ---------- */
#PrimaryButton {
    background-color: #3b6ef5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

#PrimaryButton:hover {
    background-color: #4d7cf8;
}

#PrimaryButton:pressed {
    background-color: #315fd8;
}

#PrimaryButton:disabled {
    background-color: #2a2d38;
    color: #6a6f7d;
}

#GhostButton {
    background-color: transparent;
    color: #b9bdc8;
    border: 1px solid #2e313c;
    border-radius: 8px;
    padding: 6px 10px;
}

#GhostButton:hover {
    background-color: #23262f;
    color: #ffffff;
    border-color: #3b6ef5;
}

/* ---------- Header / cards ---------- */
#Card {
    background-color: #21242c;
    border: 1px solid #2b2f3a;
    border-radius: 12px;
}

#PageTitle {
    font-size: 15px;
    font-weight: 700;
    color: #f2f2f6;
}

#Combo {
    background-color: #262a35;
    color: #e6e6eb;
    border: 1px solid #333848;
    border-radius: 8px;
    padding: 5px 10px;
    min-width: 130px;
}

#Combo:hover {
    border-color: #3b6ef5;
}

#Combo QAbstractItemView {
    background-color: #21242c;
    border: 1px solid #333848;
    selection-background-color: #2c3140;
    selection-color: #ffffff;
}

#StatusLabel {
    color: #8a8f9c;
    font-size: 12px;
    padding: 0 6px;
}

#ModelChip {
    background-color: #262a35;
    color: #7aa2ff;
    border: 1px solid #333848;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

/* ---------- Chat area ---------- */
#ChatScroll {
    background-color: #1b1d23;
    border: none;
}

#ChatScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

#ChatScroll QScrollBar::handle:vertical {
    background: #333848;
    border-radius: 4px;
    min-height: 30px;
}

#ChatScroll QScrollBar::handle:vertical:hover {
    background: #454b60;
}

#ChatScroll QScrollBar::add-line:vertical,
#ChatScroll QScrollBar::sub-line:vertical {
    height: 0;
}

#ChatBrowser {
    background-color: #262a34;
    border: 1px solid #2e3341;
    border-radius: 14px;
    padding: 10px 14px;
    color: #e6e6eb;
    selection-background-color: #3b6ef5;
    font-size: 13px;
}

#ChatBrowser a {
    color: #7aa2ff;
}

#ChatBrowser p {
    margin: 4px 0;
}

#ChatBrowser h1, #ChatBrowser h2, #ChatBrowser h3, #ChatBrowser h4 {
    color: #f2f2f6;
    margin: 10px 0 4px 0;
}

#ChatBrowser code.inline-code {
    background-color: #1d2129;
    color: #ffb86b;
    border-radius: 4px;
    padding: 1px 5px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#ChatBrowser pre.code-block {
    background-color: #171a21;
    border: 1px solid #2e3341;
    border-radius: 10px;
    padding: 10px 12px;
    margin: 8px 0;
}

#ChatBrowser pre.code-block code {
    color: #d4d7e0;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    white-space: pre-wrap;
}

#ChatBrowser blockquote {
    border-left: 3px solid #3b6ef5;
    margin: 6px 0;
    padding: 2px 10px;
    color: #aeb3c0;
}

#ChatBrowser hr {
    border: none;
    border-top: 1px solid #333848;
    margin: 8px 0;
}

#ChatBrowser ul, #ChatBrowser ol {
    margin: 4px 0;
    padding-left: 22px;
}

#UserBubble {
    background-color: #3b6ef5;
    color: #ffffff;
    border-radius: 14px;
    padding: 10px 14px;
    max-width: 620px;
    font-size: 13px;
}

#StepText {
    color: #7d8494;
    font-size: 12px;
    background-color: transparent;
}

#ErrorText {
    color: #ff7b7b;
    font-size: 12px;
    background-color: transparent;
}

/* ---------- Input ---------- */
#InputCard {
    background-color: #21242c;
    border: 1px solid #2b2f3a;
    border-radius: 14px;
}

#ChatInput {
    background-color: transparent;
    border: none;
    color: #e6e6eb;
    padding: 6px 4px;
    font-size: 13px;
}

#ChatInput:focus {
    border: none;
}

/* ---------- Stop Button ---------- */
#StopButton {
    background-color: #e5484d;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

#StopButton:hover {
    background-color: #f2555a;
}

#StopButton:pressed {
    background-color: #d13d42;
}

/* ---------- Reasoning Card & Progress ---------- */
#ReasoningCard {
    background-color: #171922;
    border: 1px solid #2d3345;
    border-radius: 10px;
    margin: 4px 0;
}

#ReasoningHeader {
    background-color: transparent;
    border: none;
    color: #9aa2b6;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 6px;
}

#ReasoningHeader:hover {
    color: #d0d7e8;
}

#ReasoningBody {
    background-color: #111319;
    border: 1px solid #232733;
    border-radius: 6px;
    color: #b0b6c6;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11.5px;
    padding: 6px;
}

/* ---------- Terminal Card ---------- */
#TerminalCard {
    background-color: #0d1117;
    border: 1px solid #21262d;
    border-radius: 10px;
    margin: 4px 0;
}

#TerminalHeader {
    background-color: transparent;
    border: none;
    color: #58a6ff;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 6px;
}

#TerminalHeader:hover {
    color: #79c0ff;
}

#TerminalBody {
    background-color: #05070a;
    border: 1px solid #161b22;
    border-radius: 6px;
    color: #3fb950;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11.5px;
    padding: 6px;
}

/* ---------- Search Input & Attachments ---------- */
#SearchInput {
    background-color: #181b22;
    border: 1px solid #2d3345;
    border-radius: 8px;
    color: #e6e6eb;
    padding: 6px 10px;
    font-size: 12px;
}

#SearchInput:focus {
    border: 1px solid #3b6ef5;
}

#AttachmentChip {
    background-color: #1c202c;
    border: 1px solid #333a4d;
    border-radius: 6px;
    padding: 2px 8px;
}

#AttachmentChip QLabel {
    color: #8bb2ff;
    font-size: 11px;
    font-weight: 500;
}

#ChipRemoveBtn {
    background-color: transparent;
    border: none;
    color: #8b949e;
    font-weight: bold;
    font-size: 11px;
    padding: 0 2px;
}

#ChipRemoveBtn:hover {
    color: #ff7b7b;
}

/* ---------- Task Checklist Card ---------- */
#TaskChecklistCard {
    background-color: #151821;
    border: 1px solid #2d3345;
    border-radius: 10px;
    margin: 6px 0;
}

#TaskChecklistHeader {
    background-color: transparent;
    border: none;
    color: #58a6ff;
    text-align: left;
    font-size: 12.5px;
    font-weight: 600;
    padding: 4px 8px;
}

#TaskChecklistHeader:hover {
    color: #79c0ff;
}

#TaskProgressBar {
    background-color: #212633;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}

#TaskProgressBar::chunk {
    background-color: #238636;
    border-radius: 4px;
}

/* ---------- Quick Action Chips ---------- */
#QuickActionChip {
    background-color: #1c202b;
    border: 1px solid #2e3547;
    border-radius: 12px;
    color: #9aa2b6;
    font-size: 11.5px;
    font-weight: 500;
    padding: 3px 10px;
}

#QuickActionChip:hover {
    background-color: #262c3b;
    color: #ffffff;
    border-color: #4d7cf8;
}

#QuickActionChip:pressed {
    background-color: #1e2433;
}

/* ---------- Workspace Badge ---------- */
#WorkspaceBadge {
    background-color: #1b1f2b;
    border: 1px solid #2e3547;
    border-radius: 6px;
    color: #8b949e;
    font-size: 11px;
    padding: 2px 8px;
}

#WorkspaceBadge:hover {
    color: #58a6ff;
    border-color: #3b6ef5;
}

/* ---------- Resource Monitor in Footer ---------- */
#ResourceMonitor {
    background-color: #141720;
    border: 1px solid #232836;
    border-radius: 6px;
    padding: 4px 8px;
}

#ResourcePill {
    font-size: 11px;
    font-family: Consolas, monospace;
    color: #8b949e;
}

#CheckpointItem {
    background-color: #161922;
    border: 1px solid #272d3d;
    border-radius: 8px;
    padding: 8px 10px;
    margin: 4px 0;
}

/* ---------- Voice Button & File Tree ---------- */
#VoiceButton {
    background-color: #1f2430;
    color: #58a6ff;
    border: 1px solid #2e3547;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
}

#VoiceButton:hover {
    background-color: #2b3242;
    border-color: #3b6ef5;
}

#VoiceButton:pressed {
    background-color: #1a1e29;
}

#FileTreeView {
    background-color: #12151d;
    border: 1px solid #272d3d;
    border-radius: 6px;
    color: #e6e6eb;
    font-size: 12px;
}

#FileTreeView::item:hover {
    background-color: #1c212e;
}

#FileTreeView::item:selected {
    background-color: #2b3859;
    color: #ffffff;
}







#TokenEstimator {
    color: #8b949e;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
    padding: 2px 6px;
}

#InputCard {
    background-color: #21242c;
    border: 1px solid #2d3345;
    border-radius: 12px;
}

#UserBubble {
    background-color: #2b56cc;
    color: #ffffff;
    border-radius: 14px;
    padding: 10px 15px;
    max-width: 680px;
    font-size: 13.5px;
}

#ChatBrowser {
    background-color: #21242d;
    border: 1px solid #2b303d;
    border-radius: 14px;
    padding: 12px 16px;
    color: #e6e6eb;
    selection-background-color: #3b6ef5;
    font-size: 13.5px;
}
