/* ============ Auto Pilot Qwen 3.8 27B IQ3_Superfast — Codex / DeepSeek Harness Dark Theme ============ */

QWidget {
    background-color: #16171b;
    color: #e6e6eb;
    font-size: 13px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "SF Pro Text", "Microsoft YaHei", "PingFang SC", "Hiragino Sans GB", "Noto Sans", Arial, sans-serif;
}

QMainWindow {
    background-color: #16171b;
}

/* ---------- Sidebar ---------- */
#Sidebar {
    background-color: #111216;
    border-right: 1px solid #23252e;
}

#SidebarHeader {
    padding: 6px 2px 2px 2px;
}

#Brand {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.3px;
}

#BrandStatus {
    font-size: 11px;
    color: #3fb950;
    font-weight: 600;
}

#SidebarSectionTitle {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #6e7687;
    padding: 8px 4px 2px 4px;
}

#MutedText {
    color: #7d8495;
    font-size: 11.5px;
}

#ChatList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 2px;
}

#ChatList::item {
    color: #c9cdd7;
    padding: 8px 10px;
    border-radius: 8px;
    margin-bottom: 2px;
    font-size: 12.5px;
}

#ChatList::item:hover {
    background-color: #1c1e26;
    color: #ffffff;
}

#ChatList::item:selected {
    background-color: #272b38;
    color: #ffffff;
    font-weight: 600;
}

/* ---------- Buttons ---------- */
#PrimaryButton {
    background-color: #3b6ef5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
    font-size: 13px;
}

#PrimaryButton:hover {
    background-color: #4d7cf8;
}

#PrimaryButton:pressed {
    background-color: #2f5ed6;
}

#PrimaryButton:disabled {
    background-color: #252834;
    color: #5d6374;
}

#CircleSendBtn {
    background-color: #3b6ef5;
    color: #ffffff;
    border: none;
    border-radius: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 15px;
    font-weight: bold;
}

#CircleSendBtn:hover {
    background-color: #4d7cf8;
}

#CircleSendBtn:pressed {
    background-color: #2f5ed6;
}

#CircleStopBtn {
    background-color: #e5484d;
    color: #ffffff;
    border: none;
    border-radius: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 14px;
    font-weight: bold;
}

#CircleStopBtn:hover {
    background-color: #f2555a;
}

#CircleStopBtn:pressed {
    background-color: #d13d42;
}

#GhostButton {
    background-color: transparent;
    color: #a6abb9;
    border: 1px solid #282b36;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12px;
}

#GhostButton:hover {
    background-color: #1e212b;
    color: #ffffff;
    border-color: #3b6ef5;
}

#GhostIconBtn {
    background-color: transparent;
    color: #9aa0b0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 6px;
    font-size: 13px;
}

#GhostIconBtn:hover {
    background-color: #21242f;
    color: #ffffff;
    border-color: #313645;
}

/* ---------- Header / Cards ---------- */
#Card {
    background-color: #1b1d24;
    border: 1px solid #272a35;
    border-radius: 12px;
}

#PageTitle {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
}

#Combo {
    background-color: #21242e;
    color: #e6e6eb;
    border: 1px solid #2f3444;
    border-radius: 7px;
    padding: 4px 8px;
    min-width: 110px;
    font-size: 12px;
}

#Combo:hover {
    border-color: #3b6ef5;
}

#Combo QAbstractItemView {
    background-color: #1b1d24;
    border: 1px solid #2f3444;
    selection-background-color: #2b3040;
    selection-color: #ffffff;
}

#StatusLabel {
    color: #8b92a4;
    font-size: 12px;
    padding: 0 4px;
}

#ModelChip {
    background-color: #202430;
    color: #79a1ff;
    border: 1px solid #2e3549;
    border-radius: 7px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
}

#TokenEstimator {
    color: #7a8296;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
    padding: 2px 6px;
    background-color: #171920;
    border: 1px solid #252834;
    border-radius: 5px;
}

/* ---------- Chat area ---------- */
#ChatScroll {
    background-color: #16171b;
    border: none;
}

#ChatScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

#ChatScroll QScrollBar::handle:vertical {
    background: #2b2e3c;
    border-radius: 4px;
    min-height: 30px;
}

#ChatScroll QScrollBar::handle:vertical:hover {
    background: #40455a;
}

#ChatScroll QScrollBar::add-line:vertical,
#ChatScroll QScrollBar::sub-line:vertical {
    height: 0;
}

#ChatBrowser {
    background-color: #1c1e26;
    border: 1px solid #262936;
    border-radius: 12px;
    padding: 12px 16px;
    color: #e6e6eb;
    selection-background-color: #3b6ef5;
    font-size: 13.5px;
    line-height: 1.5;
}

#ChatBrowser a {
    color: #6ea1ff;
    text-decoration: none;
}

#ChatBrowser a:hover {
    text-decoration: underline;
}

#ChatBrowser p {
    margin: 5px 0;
}

#ChatBrowser h1, #ChatBrowser h2, #ChatBrowser h3, #ChatBrowser h4 {
    color: #ffffff;
    margin: 12px 0 6px 0;
    font-weight: 700;
}

#ChatBrowser code.inline-code {
    background-color: #14161d;
    color: #f7a868;
    border-radius: 4px;
    padding: 2px 6px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#ChatBrowser pre.code-block {
    background-color: #111318;
    border: 1px solid #262a37;
    border-radius: 10px;
    padding: 12px 14px;
    margin: 10px 0;
}

#ChatBrowser pre.code-block code {
    color: #d8dbe4;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12.5px;
    white-space: pre-wrap;
}

#ChatBrowser blockquote {
    border-left: 3px solid #3b6ef5;
    margin: 6px 0;
    padding: 2px 12px;
    color: #a6acbd;
}

#ChatBrowser hr {
    border: none;
    border-top: 1px solid #2c303f;
    margin: 10px 0;
}

#ChatBrowser ul, #ChatBrowser ol {
    margin: 6px 0;
    padding-left: 22px;
}

#UserBubble {
    background-color: #282d3c;
    color: #ffffff;
    border: 1px solid #363c50;
    border-radius: 14px;
    padding: 10px 16px;
    max-width: 680px;
    font-size: 13.5px;
    line-height: 1.45;
}

#StepText {
    color: #7b8396;
    font-size: 12px;
    background-color: transparent;
}

#ErrorText {
    color: #ff7b7b;
    font-size: 12px;
    background-color: transparent;
}

/* ---------- Codex / DeepSeek Capsule Input Card ---------- */
#InputCard {
    background-color: #1b1d24;
    border: 1px solid #2a2e3b;
    border-radius: 16px;
    padding: 6px 12px 10px 12px;
}

#InputCard:hover {
    border-color: #383d4e;
}

#ChatInput {
    background-color: transparent;
    border: none;
    color: #f2f2f6;
    padding: 6px 2px;
    font-size: 13.5px;
    selection-background-color: #3b6ef5;
    selection-color: #ffffff;
}

#ChatInput:focus {
    border: none;
}

#ChatInput QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}

#ChatInput QScrollBar::handle:vertical {
    background: #2b2e3c;
    border-radius: 3px;
    min-height: 20px;
}

#ChatInput QScrollBar::handle:vertical:hover {
    background: #40455a;
}

#ChatInput QScrollBar::add-line:vertical,
#ChatInput QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---------- Stop Button ---------- */
#StopButton {
    background-color: #e5484d;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}

#StopButton:hover {
    background-color: #f2555a;
}

#StopButton:pressed {
    background-color: #d13d42;
}

/* ---------- Reasoning Card & Progress ---------- */
#ReasoningCard {
    background-color: #13141a;
    border: 1px solid #232632;
    border-radius: 9px;
    margin: 4px 0;
}

#ReasoningHeader {
    background-color: transparent;
    border: none;
    color: #8c94a8;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 6px;
}

#ReasoningHeader:hover {
    color: #c0c8dd;
}

#ReasoningBody {
    background-color: #0d0e12;
    border: 1px solid #1c1e26;
    border-radius: 6px;
    color: #a4abbc;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11.5px;
    padding: 6px;
}

/* ---------- Terminal Card ---------- */
#TerminalCard {
    background-color: #0c0e12;
    border: 1px solid #1f232d;
    border-radius: 9px;
    margin: 4px 0;
}

#TerminalHeader {
    background-color: transparent;
    border: none;
    color: #58a6ff;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 6px;
}

#TerminalHeader:hover {
    color: #79c0ff;
}

#TerminalBody {
    background-color: #050608;
    border: 1px solid #14171e;
    border-radius: 6px;
    color: #3fb950;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11.5px;
    padding: 6px;
}

/* ---------- Search Input & Attachments ---------- */
#SearchInput {
    background-color: #16181f;
    border: 1px solid #262935;
    border-radius: 7px;
    color: #e6e6eb;
    padding: 5px 8px;
    font-size: 12px;
}

#SearchInput:focus {
    border: 1px solid #3b6ef5;
}

#AttachmentChip {
    background-color: #1a1d27;
    border: 1px solid #2a3040;
    border-radius: 6px;
    padding: 2px 8px;
}

#AttachmentChip QLabel {
    color: #79a1ff;
    font-size: 11px;
    font-weight: 500;
}

#ChipRemoveBtn {
    background-color: transparent;
    border: none;
    color: #7d8496;
    font-weight: bold;
    font-size: 11px;
    padding: 0 2px;
}

#ChipRemoveBtn:hover {
    color: #ff7b7b;
}

/* ---------- Quick Action Chips ---------- */
#QuickActionChip {
    background-color: #1a1c24;
    color: #a2a8b8;
    border: 1px solid #272a36;
    border-radius: 12px;
    padding: 4px 11px;
    font-size: 11.5px;
    font-weight: 500;
}

#QuickActionChip:hover {
    background-color: #242733;
    color: #ffffff;
    border-color: #3b6ef5;
}

#QuickActionChip:pressed {
    background-color: #2f3446;
}

/* ---------- Telemetry Footer ---------- */
#TelemetryFooter {
    color: #636b7e;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
    padding: 2px 4px;
}

/* ---------- Profile Capsule Bottom ---------- */
#ProfileCapsule {
    background-color: #171920;
    border: 1px solid #242733;
    border-radius: 8px;
    padding: 4px 8px;
}
